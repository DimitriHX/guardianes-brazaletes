anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_crawl")
paragraphs = PackedStringArray("Emma se ha quedado dormida con el viejo brazalete de su abuela en la muñeca. Al cerrar los ojos despierta en el MUNDO DE LOS SUEÑOS, un reino donde las leyendas cobran vida.", "Pero una sombra ha corrompido el sueño. El Cadejo, la Siguanaba, la Llorona, el Cipitío y otros espíritus de la tradición se han convertido en monstruos que acechan entre los pinos y las sombras.", "Guiada por la voz del brazalete, Emma debe reunir las MONEDAS DE LUZ que abren los portales entre los mundos y purificar a los espíritus con el poder del guardián.", "Su primer destino la espera al final del Sendero de las Sombras: la guarida del temible CADEJO NEGRO, el que acecha a los viajeros en la noche...", "Solo venciendo a las leyendas corrompidas podrá despertar y devolver la paz a los sueños.")
next_scene = "res://levels/sueno_1/Bosque.tscn"

